<%- include('partials/header') %>
<h1>Seller dashboard</h1>

<div class="row">
  <div class="col">
    <div class="panel">
      <h2>List a new product</h2>
      <form action="/seller/products" method="post" class="stack">
        <label>Name</label><input type="text" name="name">
        <label>Description</label><textarea name="description"></textarea>
        <div class="row">
          <div class="col"><label>Price ($)</label><input type="number" step="0.01" name="price" value="0"></div>
          <div class="col"><label>Stock</label><input type="number" name="stock" value="10"></div>
        </div>
        <label>Category</label><input type="text" name="category" value="misc">
        <label>Image URL</label><input type="text" name="image_url" value="/img/product-default.svg">
        <button class="btn">Publish product</button>
      </form>
    </div>

    <div class="panel">
      <h2>Import product image from URL</h2>
      <p class="muted">Fetches the URL server-side and previews the response. Handy for importing images from a CDN.</p>
      <form action="/seller/import-image" method="post" class="stack">
        <label>Image / resource URL</label>
        <input type="text" name="url" placeholder="https://example.com/photo.jpg">
        <button class="btn ghost">Fetch &amp; preview</button>
      </form>
      <% if (importResult) { %>
        <h3 style="margin-top:16px">Fetch result</h3>
        <p class="muted">URL: <%= importResult.url %></p>
        <% if (importResult.error) { %>
          <div class="error-box">Fetch failed: <%= importResult.error %></div>
        <% } else { %>
          <p class="muted">HTTP <%= importResult.status %> · <%= importResult.contentType %></p>
          <div class="pre"><%= importResult.body %></div>
        <% } %>
      <% } %>
    </div>
  </div>

  <div class="col" style="max-width:420px">
    <div class="panel">
      <h2>Your products</h2>
      <% if (!products.length) { %><p class="muted">You haven't listed anything yet.</p><% } else { %>
      <table>
        <thead><tr><th>#</th><th>Name</th><th>Price</th><th>Stock</th></tr></thead>
        <tbody>
        <% products.forEach(function(p){ %>
          <tr><td><a href="/product/<%= p.id %>">#<%= p.id %></a></td><td><%= p.name %></td><td>$<%= Number(p.price).toFixed(2) %></td><td><%= p.stock %></td></tr>
        <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
    <div class="panel">
      <h2>Your orders</h2>
      <% if (!orders.length) { %><p class="muted">No orders.</p><% } else { %>
      <table>
        <thead><tr><th>#</th><th>Status</th><th>Total</th></tr></thead>
        <tbody>
        <% orders.forEach(function(o){ %>
          <tr><td><a href="/orders/<%= o.id %>">#<%= o.id %></a></td><td><%= o.status %></td><td>$<%= Number(o.total).toFixed(2) %></td></tr>
        <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
