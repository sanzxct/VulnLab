<%- include('partials/header') %>
<div class="panel" style="max-width:560px;margin:0 auto">
  <h1>✅ Order #<%= orderId %> placed</h1>
  <table>
    <tr><td>Subtotal</td><td style="text-align:right">$<%= subtotal.toFixed(2) %></td></tr>
    <tr><td>Discount</td><td style="text-align:right">-$<%= discount.toFixed(2) %></td></tr>
    <tr><th>Total charged</th><th style="text-align:right">$<%= total.toFixed(2) %></th></tr>
  </table>
  <% if (flag) { %>
    <div class="notice" style="margin-top:16px">
      Wait — the total came out at or below $0. The checkout honoured your stacked coupons without limit. That's a business-logic flaw.
    </div>
    <p>Reward flag:</p>
    <div class="flag"><%= flag %></div>
  <% } else { %>
    <p class="muted" style="margin-top:16px">Thanks for shopping ByteBazaar. <a href="/orders">View your orders →</a></p>
  <% } %>
</div>
<%- include('partials/footer') %>
